{
  "name": "backend-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nptel-notifier --local",
    "db:migrate:remote": "wrangler d1 migrations apply nptel-notifier --remote",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260509.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.16.0"
  }
}

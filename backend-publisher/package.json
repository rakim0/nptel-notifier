{
  "name": "backend-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nptel-notifier --local",
    "db:migrate:remote": "wrangler d1 migrations apply nptel-notifier --remote",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@cloudflare/workers-types": "^4.20260509.0",
    "@types/node": "^25.6.2",
    "@types/papaparse": "^5.5.2",
    "prettier": "^3.5.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.90.0",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "fzf": "^0.5.2",
    "papaparse": "^5.5.3"
  }
}
